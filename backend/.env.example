# ════════════════════════════════════════════════
# KSN AAHAAR — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════

# ── Server ──
PORT=5000
NODE_ENV=development

# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017/ksn-aahaar

# ── JWT ──
# IMPORTANT: Change to a long random string in production.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# ── Razorpay (leave empty to disable online payment) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── CORS ──
CORS_ORIGIN=http://localhost:3000

# ── WhatsApp Notifications ──
WHATSAPP_OWNER_PHONE=

# ── Email (Gmail App Password) ──
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_TO=admin@yourdomain.com
