# ════════════════════════════════════════════════════════════════
# KSN AAHAAR — Backend Environment Variables
#
# Copy this file to .env and fill in ALL values before starting.
# NEVER commit .env to version control.
#
# For Render deployment, add these as Environment Variables in
# the Render dashboard (not as a file).
# ════════════════════════════════════════════════════════════════

# ── Server ──
PORT=5000
NODE_ENV=production

# ── MongoDB ──
# Get this from MongoDB Atlas → your cluster → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/ksn-aahaar?retryWrites=true&w=majority
MONGO_URI=

# ── JWT ──
# REQUIRED. Generate a secure 64-byte hex secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never use a simple string or share this value.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS ──
# Set to your Vercel frontend URL (no trailing slash).
# During initial testing: https://your-app.vercel.app
# After domain setup:     https://ksnaahaar.com
CORS_ORIGIN=

# ── Frontend URL (used in email templates and links) ──
# Same value as CORS_ORIGIN but kept separate for clarity.
# During initial testing: https://your-app.vercel.app
# After domain setup:     https://ksnaahaar.com
FRONTEND_URL=

# ── Razorpay ──
# Test Mode keys: Razorpay Dashboard → Settings → API Keys → Test Mode
# Live Mode keys: Razorpay Dashboard → Settings → API Keys → Live Mode
# Leave empty to disable online payments (cash-on-delivery only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret: Razorpay Dashboard → Settings → Webhooks → Add → copy the secret
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp Notifications ──
# Your WhatsApp number with country code, no spaces or + sign.
# Example for Indian number: 919876543210
WHATSAPP_OWNER_PHONE=

# ── Email (Gmail SMTP via App Password) ──
# Step 1: Enable 2FA on your Gmail account.
# Step 2: Google Account → Security → App Passwords → create one for "Mail".
# Step 3: Use the generated 16-character password below (NOT your Gmail password).
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password-16-chars
# Where to send admin order alerts (can be same as EMAIL_USER or a different address)
EMAIL_TO=admin@yourdomain.com

# ── Admin Bootstrap (used only by: npm run seed) ──
# These are ONLY read by the seed script to create the initial admin account.
# After running seed once, you can remove these from your environment if desired.
# The password is hashed by bcrypt (salt=12) before being stored — it is NEVER stored in plaintext.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=KSN Admin
