# ═══ KSN AAHAAR Backend Environment Variables ═══

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/ksn-aahaar

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Razorpay (get keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# CORS
CORS_ORIGIN=http://localhost:3000

# WhatsApp (owner's phone for order notifications)
WHATSAPP_OWNER_PHONE=919876543210
