# ════════════════════════════════════════════════════════════════
# KSN AAHAAR — Frontend Environment Variables
#
# Copy this file to .env.local for local development.
# For Vercel deployment, add these as Environment Variables in
# the Vercel dashboard (not as a file).
# NEVER commit .env.local to version control.
#
# ⚠️  NEXT_PUBLIC_ variables are EXPOSED TO THE BROWSER.
#    Never put secrets (JWT_SECRET, Razorpay Key Secret, etc.)
#    in NEXT_PUBLIC_ variables.
# ════════════════════════════════════════════════════════════════

# ── Backend API URL ──
# Local development (default — no need to set if using localhost:5000)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Vercel testing: set to your Render backend URL
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# After domain setup:
# NEXT_PUBLIC_API_URL=https://api.ksnaahaar.com/api

# ── Backend hostname for Next.js Image optimization ──
# Must match the HOSTNAME ONLY (no protocol, no path) of your backend.
# Local: leave empty (localhost is handled by next.config.ts)
# Vercel testing: your-backend.onrender.com
# After domain setup: api.ksnaahaar.com
NEXT_PUBLIC_API_HOST=

# ── Razorpay (PUBLIC — Key ID only, NOT the secret) ──
# Test Mode: Razorpay Dashboard → Settings → API Keys → Test Mode → Key ID
# This is safe to expose to the browser — it is NOT the secret.
# Leave empty to disable online payments.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
